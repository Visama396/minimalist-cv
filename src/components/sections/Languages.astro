---
import Section from '@/components/Section.astro'

import { languages } from '@cv'
import { languages as eslanguages } from '@escv'
import { languages as delanguages } from '@decv'
import { languages as jalanguages } from '@jacv'
import { languages as galanguages } from '@gacv'

const { language } = Astro.props

const titles: Record<string, string> = {
  en: 'Languages',
  es: 'Idiomas',
  de: 'Sprachen',
  ja: '言語',
  ga: 'Idiomas',
}

const allLangs: Record<string, typeof languages> = {
  en: languages,
  es: eslanguages,
  de: delanguages,
  ja: jalanguages,
  ga: galanguages,
}

const langs = allLangs[language ?? 'en'] ?? languages
const title = titles[language ?? 'en'] ?? titles.en
---

<Section title={title}>
  <ul>
    {
      langs.map(({ language, fluency }) => (
        <li>
          <span>{language}: {fluency}</span>
        </li>
      ))
    }
  </ul>
</Section>

<style>
  ul {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  li {
    border-radius: 6px;
    background: #eee;
    color: black;
    font-size: 1rem;
    font-weight: 500;
    padding: .2rem .6rem;
  }
</style>