---
import Section from '@/components/Section.astro'

import { skills } from '@cv'

const { language } = Astro.props

const titles: Record<string, string> = {
  en: 'Skills',
  es: 'Habilidades',
  de: 'Kenntnisse',
  ja: 'スキル',
  ga: 'Habilidades',
}

const title = titles[language ?? 'en'] ?? titles.en
---

<Section title={title}>
  <ul>
    {
      skills.map(({ name }) => (
        <li>
          <span>{name}</span>
        </li>
      ))
    }
  </ul>
</Section>

<style>
  ul {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  li {
    border-radius: 6px;
    background: #eee;
    color: black;
    font-size: .8rem;
    font-weight: 500;
    padding: .2rem .6rem;
  }
</style>