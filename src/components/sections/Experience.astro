---
import Section from '@/components/Section.astro'

import { work } from '@cv'
import { work as eswork } from '@escv'
import { work as dework } from '@decv'
import { work as jawork } from '@jacv'
import { work as gawork } from '@gacv'

const { language } = Astro.props

const titles: Record<string, string> = {
  en: 'Experience',
  es: 'Experiencia',
  de: 'Erfahrung',
  ja: '経験',
  ga: 'Experiencia',
}

const works: Record<string, typeof work> = {
  en: work,
  es: eswork,
  de: dework,
  ja: jawork,
  ga: gawork,
}

const workexperience = works[language ?? 'en'] ?? work
const title = titles[language ?? 'en'] ?? titles.en
---
<Section title={title}>
  <ul>
    {
      workexperience.map(({ name, position, summary }) => {
        return (
          <li>
            <article>
              <header>
                <div>
                  <h3>{name}</h3>
                  <h4>{position}</h4>
                </div>
              </header>
              <footer>
                <p>{summary}</p>
              </footer>
            </article>
            
            
          </li>
        )
      })
    }
  </ul>
</Section>

<style>
  ul {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  article h3 {
    font-weight: 500;
    color: #111;
  }

  article h4 {
    color: #222;
    font-weight: 400;
  }

  header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 8px;
  }

  time {
    font-size: .85rem;
    color: #555;
  }
</style>